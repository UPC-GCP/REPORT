% ==============================================================================
% Sectioning titles.
% ==============================================================================
\usepackage{titlesec}
\def\sctitle{\bfseries}
\def\capfnt{}
\titlespacing*{\subsection}{0pt}{6mm}{3mm}
\titlespacing*{\subsubsection}{0pt}{3mm}{3mm}
\titleformat{\section}[block]{\bfseries\large\boldmath}{\phantomsection\thesection~}{0.75em}{}
\titleformat{\subsection}[block]{\bfseries\boldmath}{\phantomsection\thesubsection~}{0.75em}{}
\titleformat{\subsubsection}[runin]{\itshape}{}{5mm}{}
\setcounter{secnumdepth}{2}
\titleformat{\chapter}[display]%
{\bfseries\boldmath}
{% code
\hrulefill~\bfseries\Large{\capname}~\Huge\thechapter}% label
{2ex}% separation label-title
{\bfseries\huge\filright}% titleblock
%[2ex] % space after title

% ==============================================================================
% Header and footer.
% ==============================================================================
\usepackage{fancyhdr}
\pagestyle{fancy}
\fancyfoot{}
\def\headrulewidth{0pt}
\lhead[\fancyplain{}{\relax\thepage}]{\fancyplain{}{\rightmark}}
\rhead[\fancyplain{}{\leftmark}]{\fancyplain{}{\relax\thepage}}
\cfoot[\fancyplain{\relax\thepage}{}]{\relax\fancyplain{\thepage}{}}
\fancypagestyle{plain}{%
\fancyhf{}
\fancyfoot[C]{\relax\thepage}}
