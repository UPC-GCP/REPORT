% ==============================================================================
% Figures and captions.
% ==============================================================================
\usepackage{booktabs}
\usepackage{caption} % caption style
\usepackage{subcaption}
\usepackage{floatrow} % caption placement
\floatsetup[table]{style=plaintop}
\floatsetup{floatrowsep=qquad}
\usepackage{rotating} % sideways environment

% notes for labelfont:
% multiple options should be separated by commas,
% and can be used in case the font exists: bf,sf is ok.
% bf -> bold,
% sf-> sans serif (aka "helvetica" or "arial"),
% it -> italic,
% sc -> small caps,
% sl -> slanted (aka poor man italics)
\captionsetup{font={small},labelfont={bf},labelsep=colon}
\captionsetup[subfigure]{labelfont={}}
\def\tcaption#1{\caption{\capfnt\small #1}}
\def\mfcaption#1{\captionof{figure}{\capfnt\small #1}}

